# Code station — everything outside Neovim.
# Install with:  brew bundle --file=~/.config/nvim/station/Brewfile

# Editor + multiplexer
brew "neovim"
brew "tmux"
brew "ncurses"      # provides the tmux-256color terminfo that macOS lacks

# CLI tools
brew "ripgrep"      # Telescope live grep (<leader>sg) depends on it
brew "fd"           # fast file finder, respects .gitignore (Telescope <leader>sf)
brew "uv"           # Python projects, venvs and versions
brew "lazygit"      # git UI (<leader>gg in nvim, prefix+g in tmux)
brew "zoxide"       # `z <part-of-folder-name>` jumps there

# Node is NOT installed here: it comes from nvm (~/.nvm). Mason uses it to install
# npm-based language servers (vtsls, eslint, html/css/json), so start nvim from a
# shell where `node -v` works.

# Terminal + font
cask "ghostty"
cask "font-jetbrains-mono-nerd-font"
